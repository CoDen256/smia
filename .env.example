# Copy to .env and fill in. .env is gitignored — never commit it.
# docker-compose.yml passes these through to the backend container with
# empty defaults (D-T2): smia starts fine with any subset configured —
# a provider whose token is missing just fails at call time with a clear
# "needs a *_TOKEN" error, not a startup failure.

# smia's own shared bearer token (D-S6) — required, any random string.
# Generate with: openssl rand -hex 32
SMIA_AUTH_TOKEN=changeme

# Hugging Face Inference token — used by /stt's hf_whisper provider.
# Get one at: https://huggingface.co/settings/tokens
HF_TOKEN=

# DeepL API token — used by /translations' deepl provider (free tier works).
# Get one at: https://www.deepl.com/en/your-account/keys
DEEPL_TOKEN=

# ElevenLabs API token — used by /tts and /stt's elevenlabs provider (free
# tier works, subject to its monthly quota).
# Get one at: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_TOKEN=
